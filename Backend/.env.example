# Copia privada a .env. No publiques las credenciales.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DB?sslmode=require
# CLIENT_ID de Google para la aplicación iOS; debe coincidir con GIDClientID.
GOOGLE_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
PORT=8080
# false en Vercel. Ejecuta las migraciones antes de desplegar.
AUTO_MIGRATE=false
